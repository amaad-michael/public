[Unit]
Description=llama.cpp inference server
After=network.target

[Service]
Type=simple
User={{ llm_user }}
WorkingDirectory={{ llm_home }}
ExecStart={{ llama_server_bin }} \
  --model {{ model_dir }}/{{ model_filename }} \
  --host 0.0.0.0 \
  --port {{ server_port }} \
  --threads {{ threads }} \
  --ctx-size {{ ctx_size }} \
  --n-predict {{ n_predict }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
