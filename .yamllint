---
# yamllint configuration for this repo.
#
# line-length is relaxed from the default 80 to 120: SHA-pinned GitHub
# Actions (a security requirement — tags are mutable, SHAs are not) cannot
# fit on an 80-column line, and splitting the pin across lines would break it.
# All other default rules remain enforced.
extends: default

rules:
  line-length:
    max: 120
