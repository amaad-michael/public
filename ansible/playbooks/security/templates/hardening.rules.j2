# Monitor authentication
-w /etc/passwd -p wa -k passwd_changes
-w /etc/shadow -p wa -k shadow_changes
-w /etc/sudoers -p wa -k sudoers_changes
-w /etc/sudoers.d/ -p wa -k sudoers_changes

# Monitor SSH configuration & keys
-w /etc/ssh/sshd_config -p wa -k sshd_config_changes
-w /etc/ssh/ssh_host_{{ secure_init_hostkey_type }}_key -p wa -k ssh_hostkey_changes
-w /etc/ssh/ssh_host_{{ secure_init_hostkey_type }}_key.pub -p wa -k ssh_hostkey_changes

# Monitor privileged commands only (avoid audit flood)
-a always,exit -F arch=b64 -S execve -F euid=0 -k root_exec
