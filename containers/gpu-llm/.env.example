# gpu-llm configuration. Copy to .env and fill in the four required
# values; compose refuses to start while any of them is unset.
# Everything else has a shipped default in docker-compose.yml.

# --- Required: GPU group IDs -----------------------------------------
# The ollama container passes /dev/kfd and /dev/dri through from the
# host and must join the groups that own them, or Ollama cannot open
# the GPU and silently falls back to (very slow) CPU inference.
# Read your host's values with:
#   getent group render
#   getent group video
# and copy the number in the third field of each line.
RENDER_GID=
VIDEO_GID=

# --- Required: secrets -----------------------------------------------
# Signs Open WebUI's sessions. Pinning it keeps UI logins valid when
# the container is recreated. Generate with:
#   openssl rand -hex 32
WEBUI_SECRET_KEY=

# SearXNG's server secret, injected via the SEARXNG_SECRET env var
# (SearXNG maps it onto server.secret_key, overriding the placeholder
# in settings.yml). Generate with:
#   openssl rand -hex 32
SEARXNG_SECRET=

# --- Optional ----------------------------------------------------------
# Ollama model residency: how long a loaded model stays in memory
# after its last request. The playbook's systemd drop-in value.
# OLLAMA_KEEP_ALIVE=30m

# ROCm gfx override for cards ROCm does not autodetect. Leave unset
# for autodetect. Examples: 11.0.0 = RDNA3, 10.3.0 = RDNA2.
# HSA_OVERRIDE_GFX_VERSION=

# Models the model-init service pulls on first start, comma-separated
# (Ollama library names). The default is the playbook's list; the
# five models total roughly 30 GB of downloads and disk. Trim it to
# only what you run — every entry is pulled in full.
# OLLAMA_MODELS=qwen2.5-coder:14b,qwen2.5-coder:7b,deepseek-r1:14b,nomic-embed-text:latest,llava:13b

# Host port for Open WebUI (container port 8080). Move it if another
# stack on the same host already publishes 8080 — containers/
# optiplex-llm defaults to 8080 on loopback, for example.
# WEBUI_PORT=8080

# Host port for SearXNG. Published on 127.0.0.1 only; Open WebUI
# reaches SearXNG over the compose network, not through this port.
# SEARXNG_PORT=8888
