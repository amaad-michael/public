# cp .env.example .env && chmod 600 .env. NEVER commit .env.
# Tags below were pinned 2026-10-18 after verifying — via the Docker Hub
# registry API — that each publishes a linux/arm/v7 manifest (Grafana
# included; it has wavered on 32-bit ARM before). Re-verify before any
# bump:  docker manifest inspect prom/prometheus:<tag> | grep -A2 arm
PROM_TAG=v3.15.0
AM_TAG=v0.34.1
BB_TAG=v0.29.0
NE_TAG=v1.12.1
NTFY_TAG=v2.32.0
GRAFANA_TAG=13.2.4
GRAFANA_ADMIN_PASSWORD=REPLACE_ME
