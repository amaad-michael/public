# cp .env.example .env && chmod 600 .env && fill values. NEVER commit .env.
# Grafana admin password for the standby stack. If the deployed stack ever
# used the old inline placeholder value, rotate it when you switch to this.
GRAFANA_ADMIN_PASSWORD=

# Traefik dashboard/API BasicAuth, format user:bcrypt-hash (generation:
# SECRETS_MANAGEMENT.md). Compose passes it into the Traefik container,
# whose file provider templates it into traefik.yml.
TRAEFIK_AUTH_HASH=

# Email for the Lets Encrypt account (Traefik ACME resolver). Use a real
# address you control; certificate expiry notices go there.
ACME_EMAIL=
