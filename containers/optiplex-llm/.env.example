# optiplex-llm configuration. Copy to .env and edit; every value is
# optional because docker-compose.yml ships the same defaults, so the
# stack runs with no .env at all.

# --- Model selection -------------------------------------------------
# Any GGUF reachable over HTTPS can be served: set all three values
# together. MODEL_SHA256 is verified on every start; a mismatch is
# fatal and the model is never served unverified. Set MODEL_SHA256 to
# an empty value only if you accept serving an unverified model (a
# warning is logged).

# Default preset: Llama-3.2-3B-Instruct Q4_K_M (the OptiPlex
# playbook's default; ~2.0 GB download, ~2.6 GiB resident with mlock).
MODEL_URL=https://huggingface.co/bartowski/Llama-3.2-3B-Instruct-GGUF/resolve/main/Llama-3.2-3B-Instruct-Q4_K_M.gguf
MODEL_NAME=Llama-3.2-3B-Instruct-Q4_K_M
MODEL_SHA256=6c1a2b41161032677be168d354123594c0e6e67d2b9227c84f296ad037c728ff

# Larger preset from the playbook: Meta-Llama-3.1-8B-Instruct Q4_K_M
# (~4.9 GB download, ~5.1 GiB resident). To use it, replace the three
# values above with these, and also set CTX_SIZE=2048 and MLOCK=0
# below (the playbook's preset values for this model).
# MODEL_URL=https://huggingface.co/bartowski/Meta-Llama-3.1-8B-Instruct-GGUF/resolve/main/Meta-Llama-3.1-8B-Instruct-Q4_K_M.gguf
# MODEL_NAME=Meta-Llama-3.1-8B-Instruct-Q4_K_M
# MODEL_SHA256= (capture from a known-good download; the playbook's
#                OPEN-1 note applies - no upstream checksum manifest)

# --- Serving ---------------------------------------------------------
# Context size (playbook preset: 4096 for the 3B, 2048 for the 8B).
CTX_SIZE=4096
# Lock the model in RAM (the 3B preset does; the 8B preset does not).
MLOCK=1
# Inference threads. 0 = omit the flags and let llama-server use all
# cores, as the playbook does with the host's vCPU count.
THREADS=0
# Sampling defaults, identical to the playbook's systemd unit.
TEMP=0.2
TOP_P=0.95
MIN_P=0.01

# --- Host exposure ---------------------------------------------------
# Published on loopback only by default, like the playbook's bind.
HOST_BIND=127.0.0.1
HOST_PORT=8080
# Required if you set HOST_BIND to anything other than 127.0.0.1:
# llama-server then demands this key on its API endpoints. Generate
# one with: openssl rand -hex 32
API_KEY=
# With LAN exposure the playbook also restricted CORS origins; mirror
# that here when exposing (for example CORS_ORIGINS=localhost).
CORS_ORIGINS=
