# syntax=docker/dockerfile:1
# Backup integrity — container form of
# scripts/backups/backup_integrity_tool_v1.sh (Ansible form:
# ansible/playbooks/backups/backup_integrity.yml).
#
# A run-on-demand tool image, not a daemon. The tool inside is the
# bash script itself, byte-identical to the primary implementation
# (copied, not re-written — verified with cmp in the build notes), so
# a manifest generated by this image is byte-for-byte what the bash
# tool generates on the same tree, and each form verifies the other's
# manifests. The target tree is a bind mount at /data (see
# docker-compose.yml); the script's own generate/verify interface is
# unchanged.
#
# Base pinned by digest (multi-arch index: linux/amd64 and
# linux/arm64 v8, so the same Dockerfile builds on the Pis) —
# re-verify the digest before bumping it. The tool needs only
# coreutils (sha256sum) and findutils, both in the base image.
FROM debian:bookworm-slim@sha256:7c7b2c966bc9ee8cedfeef67e0e279108992c77681fa595db4a9d65c06ccc587

LABEL org.opencontainers.image.title="backup-integrity" \
      org.opencontainers.image.description="Container form of scripts/backups/backup_integrity_tool_v1.sh (SHA-256 manifest generate/verify)" \
      org.opencontainers.image.base.name="debian:bookworm-slim"

COPY backup_integrity_tool_v1.sh /usr/local/bin/backup_integrity_tool_v1.sh
RUN chmod 0755 /usr/local/bin/backup_integrity_tool_v1.sh \
    && install -d -m 0755 /data

WORKDIR /data

ENTRYPOINT ["/usr/local/bin/backup_integrity_tool_v1.sh"]
CMD ["generate", "/data"]
